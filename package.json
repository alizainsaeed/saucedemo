{
  "name": "saucedemo",
  "version": "1.0.0",
  "description": "Sauce Demo automation project",
  "scripts": {
    "format": "npx prettier --write '**/*.{ts,spec.ts,setup.ts}'",
    "test": "npx playwright test --project=chromium --project=firefox --project=webkit",
    "ui": "npx playwright test --project=setup && npx playwright test --ui --project=chromium --project=firefox --project=webkit"
  },
  "keywords": [
    "playwright",
    "saucedemo"
  ],
  "author": "alizainsaeed",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10"
  }
}
